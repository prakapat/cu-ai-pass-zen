# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: MySQL connection string for Prisma. Local dev uses the
# mysql service in docker-compose.yml (docker compose up -d mysql) — must
# match MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE below.
# On Railway, this is auto-injected by the MySQL plugin (reference its
# ${{MySQL.MYSQL_URL}} variable in the app service's variables).
DATABASE_URL="mysql://MY_MYSQL_USER:MY_MYSQL_PASSWORD@localhost:3306/MY_MYSQL_DATABASE"

# MYSQL_*: credentials for the local docker-compose mysql service only
# (docker-compose.yml reads these — not used on Railway, which provides its
# own MySQL plugin credentials directly as DATABASE_URL).
MYSQL_ROOT_PASSWORD="MY_MYSQL_ROOT_PASSWORD"
MYSQL_DATABASE="MY_MYSQL_DATABASE"
MYSQL_USER="MY_MYSQL_USER"
MYSQL_PASSWORD="MY_MYSQL_PASSWORD"

# SESSION_SECRET: signs the express-session cookie. Required in production —
# falls back to an insecure dev default locally if unset.
SESSION_SECRET="MY_SESSION_SECRET"

# SEED_DEMO_PASSWORD: password bcrypt-hashed into the 4 demo accounts
# (requester1/approver1/finance1/admin1) by `prisma db seed`. Required to run
# the seed script — prototype-only, not a real user credential.
SEED_DEMO_PASSWORD="MY_SEED_DEMO_PASSWORD"

# NODE_ENV: set to "production" on Railway (enables the built dist/ static
# serve path and the secure session cookie flag in server.ts).
NODE_ENV="production"
